<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	
	<parent>
    	<groupId>org.geojsf</groupId>
    	<artifactId>geojsf</artifactId>
    	<version>0.1.2-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
	</parent>
	
    <artifactId>geojsf-xml</artifactId>
    <packaging>pom</packaging>
    <name>GeoJSF - XML</name>

	<properties>
		<!-- Each JAXB variant compiles and packages in its own output directory; neither is privileged -->
		<xml.classes.javax>${project.build.directory}/classes-javax</xml.classes.javax>
		<xml.classes.jakarta>${project.build.directory}/classes-jakarta</xml.classes.jakarta>
	</properties>

	<dependencyManagement>
		<dependencies>      	         
			<dependency>
				<groupId>org.geojsf</groupId>
				<artifactId>geojsf-bom</artifactId>
				<version>${project.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
   	
	<dependencies>
		<!-- Interfaces -->
		<dependency>
			<groupId>org.geojsf</groupId>
			<artifactId>geojsf-interfaces</artifactId>
		</dependency>
		<dependency>
			<groupId>org.jeesl</groupId>
  			<artifactId>jeesl-interfaces</artifactId>
		</dependency>
		
		<!-- XML Modules -->
		<dependency>
   	   		<groupId>net.sf.exlp</groupId>
   	   		<artifactId>exlp-xml</artifactId>
   	   		<classifier>javax</classifier>
   	   		<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>org.jeesl</groupId>
			<artifactId>jeesl-xml</artifactId>
			<classifier>javax</classifier>
			<scope>provided</scope>
		</dependency>
		
		<!-- JAXB 
     	<dependency>
  	   		<groupId>javax.xml.bind</groupId>
  	   		<artifactId>jaxb-api</artifactId>
  	   		<scope>provided</scope>
  	   	</dependency>
  	   	<dependency>
  	   		<groupId>com.sun.xml.bind</groupId>
  	   		<artifactId>jaxb-impl</artifactId>
  	   		<scope>provided</scope>
  	   	</dependency> -->
  	   	
  	   	<dependency>	<!-- JAXB EE10 -->
			<groupId>jakarta.xml.bind</groupId>
			<artifactId>jakarta.xml.bind-api</artifactId>
			<version>4.0.0</version>
			<scope>provided</scope>
		</dependency> 
      	<dependency>	<!-- JAXB: EE8 -->
			<groupId>javax.xml.bind</groupId>
			<artifactId>jaxb-api</artifactId>
    		<type>jar</type>
    		<version>2.3.1</version>
    		<scope>provided</scope>
		</dependency>
  	   	
  	   	<!-- JSON -->
   	   	<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
		   <groupId>com.fasterxml.jackson.datatype</groupId>
		   <artifactId>jackson-datatype-jsr310</artifactId>
		   <scope>provided</scope>
		</dependency>
		
		<!-- Logging -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.logging.log4j</groupId>
			<artifactId>log4j-slf4j2-impl</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
   			<groupId>org.slf4j</groupId>
			<artifactId>jcl-over-slf4j</artifactId>
			<scope>test</scope>
		</dependency>
		
		<!-- Test -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
			<scope>test</scope>
		</dependency>
		
		<dependency>
			<groupId>org.jeesl</groupId>
			<artifactId>jeesl-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.jeesl</groupId>
			<artifactId>jeesl-util</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
   	   		<groupId>net.sf.exlp</groupId>
   	   		<artifactId>exlp-test</artifactId>
   	   		<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.glassfish.jaxb</groupId>
			<artifactId>jaxb-runtime</artifactId>
			<version>2.3.9</version>
			<scope>provided</scope>
		</dependency>
		<!--
		<dependency>
	 		<groupId>commons-configuration</groupId>
			<artifactId>commons-configuration</artifactId>
			<type>jar</type>
			<scope>test</scope>
			<exclusions>
        		<exclusion>
        			<artifactId>commons-logging</artifactId>
        			<groupId>commons-logging</groupId>
        		</exclusion>
        	</exclusions>
		</dependency> -->
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-configuration2</artifactId>
			 <scope>compile</scope>
			 <exclusions>
        		<exclusion>
        			<artifactId>commons-logging</artifactId>
        			<groupId>commons-logging</groupId>
        		</exclusion>
        	</exclusions>
		</dependency>
	</dependencies>
	
	<build>
		<!-- The javax classes are the module output directory, so that the test compilation and the test goal resolve them -->
		<outputDirectory>${xml.classes.javax}</outputDirectory>
		<plugins>
			<!-- One compilation per JAXB variant; the module publishes no main artifact -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<execution>
						<id>compile-javax</id>
						<phase>compile</phase>
						<goals><goal>compile</goal></goals>
						<configuration>
							<release>8</release>
							<outputDirectory>${xml.classes.javax}</outputDirectory>
							<compileSourceRoots>
								<compileSourceRoot>${project.basedir}/src/main/java</compileSourceRoot>
								<compileSourceRoot>${project.basedir}/src/main/javax</compileSourceRoot>
							</compileSourceRoots>
						</configuration>
					</execution>
					<execution>
						<id>compile-jakarta</id>
						<phase>compile</phase>
						<goals><goal>compile</goal></goals>
						<configuration>
							<release>11</release>
							<outputDirectory>${xml.classes.jakarta}</outputDirectory>
							<compileSourceRoots>
								<compileSourceRoot>${project.basedir}/src/main/java</compileSourceRoot>
								<compileSourceRoot>${project.basedir}/src/main/jakarta</compileSourceRoot>
							</compileSourceRoots>
						</configuration>
					</execution>
					<execution>
						<id>testCompile</id>
						<phase>test-compile</phase>
						<goals><goal>testCompile</goal></goals>
						<configuration>
							<compileSourceRoots>
								<compileSourceRoot>${project.basedir}/src/test/java</compileSourceRoot>
							</compileSourceRoots>
							<outputDirectory>${project.build.testOutputDirectory}</outputDirectory>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- POM packaging binds no resources or test phase; the copy and the test goal run explicitly -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<version>3.3.1</version>
				<executions>
					<execution>
						<id>testResources</id>
						<phase>process-test-resources</phase>
						<goals><goal>testResources</goal></goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<executions>
					<execution>
						<id>test</id>
						<phase>test</phase>
						<goals><goal>test</goal></goals>
					</execution>
				</executions>
			</plugin>
			<!-- The classifier jars are the artifacts of the module -->
			<plugin>
  				<groupId>org.apache.maven.plugins</groupId>
  				<artifactId>maven-jar-plugin</artifactId>
				<version>3.4.2</version>
				<executions>
  					<execution>
						<id>jar-javax</id>
						<phase>process-classes</phase>
						<goals><goal>jar</goal></goals>
						<configuration>
							<classifier>javax</classifier>
							<classesDirectory>${xml.classes.javax}</classesDirectory>
						</configuration>
					</execution>
					<execution>
						<id>jar-jakarta</id>
						<phase>process-classes</phase>
						<goals><goal>jar</goal></goals>
						<configuration>
							<classifier>jakarta</classifier>
							<classesDirectory>${xml.classes.jakarta}</classesDirectory>
						</configuration>
					</execution>
					<execution>
						<id>jar-tests</id>
						<phase>package</phase>
						<goals><goal>test-jar</goal></goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
		        <groupId>org.apache.maven.plugins</groupId>
		        <artifactId>maven-pmd-plugin</artifactId>
		        <configuration>
			        <excludes>
			            <exclude>org/geojsf/model/xml/area/*.java</exclude>
			            <exclude>org/geojsf/model/xml/geojsf/*.java</exclude>
			            <exclude>org/geojsf/model/xml/government/*.java</exclude>
			            <exclude>org/geojsf/model/xml/monitoring/*.java</exclude>
			            <exclude>org/geojsf/model/xml/specs/gml/*.java</exclude>
			            <exclude>org/geojsf/model/xml/specs/ogc/*.java</exclude>
			            <exclude>org/geojsf/model/xml/specs/se/*.java</exclude>
			            <exclude>org/geojsf/model/xml/specs/sld/*.java</exclude>
			            <exclude>org/geojsf/model/xml/specs/wfs/*.java</exclude>
					</excludes>
	        </configuration>
	      </plugin>
        </plugins>
	</build>
	
	<profiles>
		<profile>
			<id>javax</id>
			<build>
				<plugins>
					<plugin>
		        		<groupId>org.apache.cxf</groupId>
		    			<artifactId>cxf-xjc-plugin</artifactId>
		    			<version>3.3.2</version>
		    			<executions>
		        			<execution> 
		            			<id>xjc</id>
		            			<phase>generate-sources</phase>
		            			<goals><goal>xsdtojava</goal></goals>
		  	         			<configuration>
									<sourceRoot>${basedir}/src/main/javax</sourceRoot>
		                			<xsdOptions>
		                    			<xsdOption>
											<bindingFile>${basedir}/src/main/xsd/javax.xjb</bindingFile>
											<extensionArgs><arg>-encoding</arg><arg>UTF-8</arg><arg>-no-header</arg></extensionArgs>
		                        			<xsd>${basedir}/src/main/xsd/xsd.xsd</xsd>
		                    			</xsdOption>
									</xsdOptions>
		            			</configuration>
		        			</execution>
		    			</executions>                    
					</plugin>
					<plugin>
						<artifactId>maven-clean-plugin</artifactId>
						<version>3.3.2</version>
						<executions>
							<execution>
								<id>xjc-clean</id>
	                    		<phase>process-sources</phase>
								<goals><goal>clean</goal></goals>
								<configuration>
									<filesets>
										<fileset><directory>src/main/javax/org/exlp</directory><followSymlinks>false</followSymlinks></fileset>
										<fileset><directory>src/main/javax/org/jeesl</directory><followSymlinks>false</followSymlinks></fileset>
									</filesets>
								</configuration>
							</execution>
						</executions>
 					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>jakarta</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.cxf</groupId>
						<artifactId>cxf-xjc-plugin</artifactId>
						<version>4.0.0</version>
						<executions>
							<execution>
								<id>xjc</id>
								<phase>generate-sources</phase>
								<goals><goal>xsdtojava</goal></goals>
								<configuration>
									<sourceRoot>${basedir}/src/main/jakarta</sourceRoot>
									<xsdOptions>
										<xsdOption>
											<bindingFile>${basedir}/src/main/xsd/jakarta.xjb</bindingFile>
											<extensionArgs><arg>-encoding</arg><arg>UTF-8</arg><arg>-no-header</arg></extensionArgs>
											<xsd>${basedir}/src/main/xsd/xsd.xsd</xsd>
										</xsdOption>
									</xsdOptions>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<artifactId>maven-clean-plugin</artifactId>
						<version>3.3.2</version>
						<executions>
							<execution>
								<id>xjc-clean</id>
								<phase>process-sources</phase>
								<goals><goal>clean</goal></goals>
								<configuration>
									<filesets>
										<fileset><directory>src/main/jakarta/org/exlp</directory><followSymlinks>false</followSymlinks></fileset>
										<fileset><directory>src/main/jakarta/org/jeesl</directory><followSymlinks>false</followSymlinks></fileset>
									</filesets>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>